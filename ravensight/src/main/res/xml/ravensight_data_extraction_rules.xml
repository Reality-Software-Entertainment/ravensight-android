<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device transfer rules for Android 12 and above
    (android:dataExtractionRules). Keeps the Ravensight device id, the
    player's opt-out and the exit marker out of cloud backup and device
    transfer. Copy the exclude lines into your own rules file if you already
    have one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ravensight.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ravensight.xml" />
    </device-transfer>
</data-extraction-rules>
